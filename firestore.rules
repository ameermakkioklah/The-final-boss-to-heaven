rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared hardened primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isVerifiedOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPlayerName(name) {
      return name is string
        && name.size() >= 2
        && name.size() <= 20
        && name.matches('^[^<>&"\'/\\\\{}\\[\\]\\r\\n\\t]+$');
    }

    function isValidPlayerProfile(data) {
      return data.keys().hasAll([
          'uid',
          'playerName',
          'playerNameLower',
          'dragonKills',
          'matchesPlayed',
          'wins',
          'losses',
          'bestTimeMs',
          'lastOutcome',
          'lastDurationMs',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'playerName',
          'playerNameLower',
          'dragonKills',
          'matchesPlayed',
          'wins',
          'losses',
          'bestTimeMs',
          'lastOutcome',
          'lastDurationMs',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && isValidPlayerName(data.playerName)
        && data.playerNameLower is string
        && data.playerNameLower.size() >= 2
        && data.playerNameLower.size() <= 20
        && data.playerNameLower == data.playerName.lower()
        && data.dragonKills is int
        && data.dragonKills >= 0
        && data.dragonKills <= 1000000
        && data.matchesPlayed is int
        && data.matchesPlayed >= 0
        && data.matchesPlayed <= 1000000
        && data.wins is int
        && data.wins >= 0
        && data.wins <= 1000000
        && data.losses is int
        && data.losses >= 0
        && data.losses <= 1000000
        && data.dragonKills == data.wins
        && data.matchesPlayed == data.wins + data.losses
        && (
          (data.bestTimeMs == null && data.dragonKills == 0)
          || (data.bestTimeMs is int && data.bestTimeMs >= 1000 && data.bestTimeMs <= 3600000 && data.dragonKills >= 1)
        )
        && data.lastOutcome in ['none', 'win', 'loss']
        && data.lastDurationMs is int
        && data.lastDurationMs >= 0
        && data.lastDurationMs <= 3600000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isInitialPlayerState() {
      return incoming().dragonKills == 0
        && incoming().matchesPlayed == 0
        && incoming().wins == 0
        && incoming().losses == 0
        && incoming().bestTimeMs == null
        && incoming().lastOutcome == 'none'
        && incoming().lastDurationMs == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
    }

    function isRenameAction() {
      return incoming().diff(existing()).affectedKeys().hasOnly([
          'playerName',
          'playerNameLower',
          'updatedAt'
        ]);
    }

    function isRecordWinAction() {
      return incoming().diff(existing()).affectedKeys().hasOnly([
          'dragonKills',
          'matchesPlayed',
          'wins',
          'bestTimeMs',
          'lastOutcome',
          'lastDurationMs',
          'updatedAt',
          'playerName',
          'playerNameLower'
        ])
        && incoming().dragonKills == existing().dragonKills + 1
        && incoming().wins == existing().wins + 1
        && incoming().matchesPlayed == existing().matchesPlayed + 1
        && incoming().losses == existing().losses
        && incoming().lastOutcome == 'win'
        && incoming().lastDurationMs >= 1000
        && incoming().lastDurationMs <= 3600000
        && (
          (existing().bestTimeMs == null && incoming().bestTimeMs == incoming().lastDurationMs)
          || (
            existing().bestTimeMs is int
            && incoming().bestTimeMs <= existing().bestTimeMs
            && (
              incoming().bestTimeMs == existing().bestTimeMs
              || incoming().bestTimeMs == incoming().lastDurationMs
            )
          )
        );
    }

    function isRecordLossAction() {
      return incoming().diff(existing()).affectedKeys().hasOnly([
          'matchesPlayed',
          'losses',
          'lastOutcome',
          'lastDurationMs',
          'updatedAt',
          'playerName',
          'playerNameLower'
        ])
        && incoming().dragonKills == existing().dragonKills
        && incoming().wins == existing().wins
        && incoming().bestTimeMs == existing().bestTimeMs
        && incoming().losses == existing().losses + 1
        && incoming().matchesPlayed == existing().matchesPlayed + 1
        && incoming().lastOutcome == 'loss'
        && incoming().lastDurationMs >= 1000
        && incoming().lastDurationMs <= 3600000;
    }

    function isValidMatchRun(data) {
      return data.keys().hasAll([
          'uid',
          'playerName',
          'outcome',
          'dragonKilled',
          'durationMs',
          'damageDealt',
          'critsLanded',
          'parriesLanded',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'playerName',
          'outcome',
          'dragonKilled',
          'durationMs',
          'damageDealt',
          'critsLanded',
          'parriesLanded',
          'createdAt'
        ])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && isValidPlayerName(data.playerName)
        && data.outcome in ['win', 'loss']
        && data.dragonKilled is bool
        && ((data.outcome == 'win' && data.dragonKilled == true) || (data.outcome == 'loss' && data.dragonKilled == false))
        && data.durationMs is int
        && data.durationMs >= 1000
        && data.durationMs <= 3600000
        && data.damageDealt is int
        && data.damageDealt >= 0
        && data.damageDealt <= 1000000
        && data.critsLanded is int
        && data.critsLanded >= 0
        && data.critsLanded <= 10000
        && data.parriesLanded is int
        && data.parriesLanded >= 0
        && data.parriesLanded <= 10000
        && data.createdAt is timestamp;
    }

    match /players/{playerId} {
      // Owner can always check/read their own profile (even before creation); public non-PII leaderboard reads bounded by query limit
      allow get: if isValidId(playerId) && (
        isVerifiedOwner(playerId)
        || (resource != null && existing().uid is string)
      );
      allow list: if request.query.limit != null && request.query.limit <= 100;

      allow create: if isVerifiedOwner(playerId)
        && isValidId(playerId)
        && isValidPlayerProfile(incoming())
        && isInitialPlayerState();

      allow update: if isVerifiedOwner(playerId)
        && isValidId(playerId)
        && isValidPlayerProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isRenameAction()
          || isRecordWinAction()
          || isRecordLossAction()
        );

      allow delete: if false;
    }

    match /matches/{matchId} {
      // Public non-PII live match feed reads bounded by query limit
      allow get: if isValidId(matchId) && resource != null;
      allow list: if request.query.limit != null && request.query.limit <= 50;

      allow create: if isVerifiedUser()
        && isValidId(matchId)
        && isValidMatchRun(incoming())
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/players/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/players/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/players/$(request.auth.uid)).data.matchesPlayed
          == get(/databases/$(database)/documents/players/$(request.auth.uid)).data.matchesPlayed + 1;

      allow update, delete: if false;
    }
  }
}
